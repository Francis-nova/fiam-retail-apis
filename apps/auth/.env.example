NODE_ENV=development

AUTH_PORT=7001
AUTH_DATABASE_URL=postgres://postgres:postgres@localhost:5432/fiam_auth

JWT_ACCESS_SECRET=change-me-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-min-32-chars
JWT_REFRESH_TTL=30d

OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SMS — Termii (https://developers.termii.com/messaging-api)
SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com

# BVN verification — QoreID (https://docs.qoreid.com/reference/bvn)
KYC_PROVIDER=qoreid
QOREID_CLIENT_ID=
QOREID_SECRET=
QOREID_BASE_URL=https://api.qoreid.com

# MinIO — KYC document uploads (government ID, proof of address, etc.)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=fiam-kyc-documents

# RabbitMQ — message bus to the payment service
RABBITMQ_URL=amqp://guest:guest@localhost:5672
