NODE_ENV=development

AUTH_PORT=7001
AUTH_DATABASE_URL=postgres://postgres:postgres@localhost:5432/fiam_auth

JWT_ACCESS_SECRET=change-me-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-min-32-chars
JWT_REFRESH_TTL=30d

OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# BVN verification — QoreID (https://docs.qoreid.com/reference/bvn)
# qoreid = real BVN lookup | passthrough = STAGING ONLY, trusts submitted BVN/DOB
KYC_PROVIDER=qoreid
QOREID_CLIENT_ID=
QOREID_SECRET=
QOREID_BASE_URL=https://api.qoreid.com
# Optional separate QoreID project for the NIN liveness (liveness_nin) SDK
# session. Blank = fall back to QOREID_CLIENT_ID / QOREID_SECRET above.
QOREID_LIVENESS_CLIENT_ID=
QOREID_LIVENESS_SECRET=

# Shared secret for /internal/* (service-to-service). Must match payment's.
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=

# MinIO — KYC document uploads (government ID, proof of address, etc.)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=fiam-kyc-documents

# RabbitMQ — message bus to the payment service (account provisioning) and
# postoffice (SMS/email/push)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Local dev only: return OTP codes in API responses so the app can show them
# on screen. Ignored when NODE_ENV=production. Leave unset in staging/prod.
EXPOSE_DEV_OTP=true

# CBN circular (12 Mar 2026): after activating on a new device, an existing
# customer may send at most this much in total for the first N hours.
# 20000 / 24 are the CBN maximums — lower is allowed, higher is not.
NEW_DEVICE_LIMIT_NGN=20000
NEW_DEVICE_LIMIT_HOURS=24
