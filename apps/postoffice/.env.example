NODE_ENV=development

POSTOFFICE_PORT=7002

# RabbitMQ — postoffice has no REST API for other services; it only ever
# hears about work to do (send this email/SMS/push) via messages on this
# broker.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# SMS — Termii (https://developers.termii.com/messaging-api)
SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
