doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="color-scheme" content="light")
    meta(name="supported-color-schemes" content="light")
    title= subject
  body(style="margin:0; padding:0; background-color:#F1F1F1; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;")
    table(role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F1F1F1;")
      tr
        td(align="center" style="padding:48px 16px;")
          table(role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:480px; background-color:#FFFFFF; border-radius:20px;")
            tr
              td(style="padding:40px 40px 8px 40px;")
                img(src=logoUrl alt="Fiam" height="28" style="display:block; height:28px; width:auto; border:0;")
            tr
              td(style="padding:32px 40px 40px 40px;")
                block content
            tr
              td(style="padding:0 40px 40px 40px;")
                table(role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0")
                  tr
                    td(style="border-top:1px solid #EBEDF0; padding-top:20px;")
                      p(style="margin:0; font-size:12px; line-height:1.6; color:#7F7F7F;") This is an automated message from Fiam. If you didn't expect this email, you can safely ignore it.
                      p(style="margin:8px 0 0 0; font-size:12px; line-height:1.6; color:#7F7F7F;")
                        | &copy; #{year} Fiam. All rights reserved.
