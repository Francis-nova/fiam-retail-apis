extends layout
include mixins

block content
  +heading('Your password was changed')
  +greeting(firstName)
  p(style="margin:0 0 16px 0; font-size:15px; line-height:1.6; color:#000909;")
    | Your Fiam account password was changed on #{changedAt}.
  p(style="margin:0; font-size:14px; line-height:1.6; color:#7F7F7F;")
    | If you made this change, no action is needed. If you didn't, please contact support immediately.
