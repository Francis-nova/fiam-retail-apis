mixin heading(text)
  h1(style="margin:0 0 12px 0; font-size:22px; line-height:1.3; font-weight:700; color:#000909;")= text

mixin greeting(name)
  p(style="margin:0 0 16px 0; font-size:15px; line-height:1.6; color:#000909;")
    | Hi #{name},

mixin detailsCard()
  table(role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F1F1F1; border-radius:10px; margin:8px 0 20px 0;")
    tr
      td(style="padding:16px 20px;")
        table(role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0")
          block

mixin row(label, value)
  tr
    td(style="font-size:13px; line-height:1.8; color:#7F7F7F; padding-bottom:8px;")= label
    td(align="right" style="font-size:13px; line-height:1.8; color:#000909; font-weight:700; padding-bottom:8px;")= value

mixin codeBox(code)
  table(role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;")
    tr
      td(align="center" style="background-color:#F1F1F1; border:1px solid #EBEDF0; border-radius:10px; padding:20px;")
        span(style="font-size:32px; font-weight:700; letter-spacing:8px; color:#000909;")= code

mixin amount(value, tone)
  - var color = tone === 'debit' ? '#4C1F1F' : '#000909'
  p(style="margin:0 0 24px 0; font-size:32px; font-weight:700; line-height:1.0; color:" + color + ";")= value

mixin badge(label, tone)
  - var bg = tone === 'credit' ? '#1F4C44' : (tone === 'debit' ? '#BC5355' : '#EBEDF0')
  - var fg = tone === 'neutral' ? '#000909' : '#FFFFFF'
  table(role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px 0;")
    tr
      td(style="background-color:" + bg + "; border-radius:999px; padding:6px 14px;")
        span(style="font-size:12px; font-weight:700; color:" + fg + "; letter-spacing:0.3px;")= label
