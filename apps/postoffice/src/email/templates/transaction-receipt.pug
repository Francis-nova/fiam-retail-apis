extends layout
include mixins

block content
  - var isCredit = direction === 'credit'
  - var isAdjustment = typeof adjustment !== 'undefined' && adjustment === 'true'
  - var badgeLabel = isCredit ? 'Credit' : 'Debit'
  - var title = isAdjustment ? (isCredit ? 'Account credited' : 'Account debited') : (isCredit ? 'Money received' : 'Money sent')
  - var signedAmount = (isCredit ? '+' : '-') + amount
  - var counterpartyLabel = isAdjustment ? 'Description' : (isCredit ? 'From' : 'To')
  +badge(badgeLabel, direction)
  +heading(title)
  +greeting(firstName)
  +amount(signedAmount, direction)
  +detailsCard()
    +row(counterpartyLabel, counterparty)
    +row('Reference', reference)
    +row('Status', status)
    +row('Date', occurredAt)
  if isAdjustment && !isCredit
    p(style="margin:16px 0 0 0; font-size:14px; line-height:1.6; color:#7F7F7F;")
      | If you don't recognise this adjustment, please contact Fiam support.
