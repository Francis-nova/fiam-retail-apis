NODE_ENV=development

PAYMENT_PORT=7003
PAYMENT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/fiam_payment

# RabbitMQ — message bus from the auth service
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Redis — BullMQ transaction-processing queue
REDIS_URL=redis://localhost:6379

# Must match apps/auth/.env's JWT_ACCESS_SECRET exactly (shared secret,
# lets this service verify auth-issued tokens without calling back to auth)
JWT_ACCESS_SECRET=change-me-min-32-chars

# NGN provider selection (extensible: PAYMENT_PROVIDER_USD, PAYMENT_PROVIDER_GBP later)
PAYMENT_PROVIDER_NGN=vfd

# VFD wallet/account provisioning (https://vbaas-docs.vfdtech.ng/)
VFD_AUTH_BASE_URL=https://api-devapps.vfdbank.systems/vfd-tech/baas-portal/v1.1/baasauth
VFD_WALLET_BASE_URL=https://api-devapps.vfdbank.systems/vtech-wallet/api/v2/wallet2
VFD_CONSUMER_KEY=
VFD_CONSUMER_SECRET=
VFD_WEBHOOK_SECRET=
# VFD's own bank code (for intra vs inter transfer detection) and the
# "wallet name" VFD requires prefixed onto every transfer reference.
VFD_BANK_CODE=999999
VFD_WALLET_NAME=FiamWallet
