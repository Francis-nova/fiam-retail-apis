NODE_ENV=development
ADMIN_PORT=7004
CORS_ORIGIN=http://localhost:5173

# Own database — staff, refresh tokens, audit log.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/fiam_admin

# Read-only access into the other services' databases. Use a dedicated
# read-only Postgres role in staging/production, never the owner role.
AUTH_READONLY_DATABASE_URL=postgres://postgres:postgres@localhost:5432/fiam_auth
PAYMENT_READONLY_DATABASE_URL=postgres://postgres:postgres@localhost:5432/fiam_payment

# MUST differ from the customer-facing JWT_ACCESS_SECRET.
ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_ACCESS_TTL=15m
ADMIN_JWT_REFRESH_TTL_DAYS=7

# Staff two-factor auth. Key encrypts TOTP secrets at rest (`openssl rand -hex 32`).
ADMIN_TOTP_ENCRYPTION_KEY=
# true = every staff member must enrol in 2FA before they can sign in.
ADMIN_REQUIRE_2FA=false

# Optional: comma-separated IPs / CIDRs allowed to reach this API (e.g. the
# office or VPN egress). Leave blank to NOT enforce. /health is always open.
ADMIN_ALLOWED_IPS=

# Writes go through the owning service's /internal API.
AUTH_INTERNAL_URL=http://localhost:7001
PAYMENT_INTERNAL_URL=http://localhost:7003
# Same value as apps/auth/.env INTERNAL_API_KEY.
INTERNAL_API_KEY=
