# Copy to docker/.env on the server and fill in real values. Never commit
# the filled-in version. `docker stack deploy` has no --env-file flag — it
# auto-loads a file literally named `.env` from the current directory for
# ${VAR} substitution (same mechanism `docker compose` uses), which is why
# this must be named exactly `docker/.env` and every `docker stack deploy`
# command must be run from inside `docker/`. Traefik's ACME_EMAIL lives in
# this same file even though only traefik-stack.yml uses it — one shared
# file for both stacks since they live in the same directory.

# --- Let's Encrypt (traefik-stack.yml only) ---
ACME_EMAIL=

# --- Image to deploy (CI pushes here on every push to `staging`) ---
IMAGE=ghcr.io/francis-nova/fiam-retail-apis:staging

# --- Postgres (single instance, two databases — see postgres/init-databases.sh) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_USER=fiam
RABBITMQ_PASSWORD=

# --- MinIO (KYC document storage, used by auth) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=fiam-kyc-documents

# --- Shared JWT secrets — JWT_ACCESS_SECRET MUST be byte-identical between
# auth and payment (payment verifies auth-issued tokens without calling
# back to auth). Generate with: openssl rand -base64 48 ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d

# --- CORS (NODE_ENV=production disables CORS entirely in every app — this
# var only takes effect if that's changed later) ---
CORS_ORIGIN=*

# --- QoreID (BVN/NIN KYC — auth). Leave blank to keep KYC endpoints
# reachable but returning a clear error until real credentials exist. ---
QOREID_CLIENT_ID=
QOREID_SECRET=
QOREID_BASE_URL=https://api.qoreid.com
# Optional separate QoreID project for NIN liveness (liveness_nin). Blank =
# fall back to QOREID_CLIENT_ID / QOREID_SECRET.
QOREID_LIVENESS_CLIENT_ID=
QOREID_LIVENESS_SECRET=
# The webhook secret you set in QoreID's dashboard (Webhooks > Configuration). QoreID signs
# every call with HMAC-SHA512 over the body using it. Endpoint: POST /webhooks/qoreid on the auth host.
QOREID_WEBHOOK_SECRET=

# --- VFD (wallet/payout provider — payment). Same "blank is safe" pattern
# as QoreID above. ---
VFD_AUTH_BASE_URL=https://api-devapps.vfdbank.systems/vfd-tech/baas-portal/v1.1/baasauth
VFD_WALLET_BASE_URL=https://api-devapps.vfdbank.systems/vtech-wallet/api/v2/wallet2
VFD_CONSUMER_KEY=
VFD_CONSUMER_SECRET=
VFD_WEBHOOK_AUTH_TOKEN=
VFD_BANK_CODE=999999
VFD_WALLET_NAME=ADL

# --- Termii (SMS — postoffice) ---
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com

# --- ZeptoMail (email — postoffice) ---
EMAIL_FROM_ADDRESS=noreply@usefiam.com
EMAIL_FROM_NAME=Fiam
# Staging only: tags email subjects/bodies as test mail. Leave blank in production.
EMAIL_ENV_LABEL=
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_BASE_URL=api.zeptomail.com/

# --- Service-to-service key (auth + payment). Generate: openssl rand -hex 32.
# Payment uses it to look up a customer's email from auth for transaction
# receipts; blank = those emails are skipped. ---
INTERNAL_API_KEY=

# --- OneSignal (push — postoffice). Dashboard > Settings > Keys & IDs. Blank =
# push sends fail with "Push delivery is not configured". ---
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# BVN verification. Leave as qoreid except on staging, where `passthrough`
# skips the BVN lookup and trusts the submitted BVN/DOB (e.g. VFD test BVNs).
KYC_PROVIDER=qoreid

# --- Admin console API (apps/admin) ---
# Run docker/postgres/admin-roles.sql ONCE on the server first (it creates
# the roles these passwords belong to). Use hex passwords (openssl rand -hex
# 24) — they go into connection URLs, so avoid / @ : % characters.
ADMIN_DB_PASSWORD=
READONLY_DB_PASSWORD=
# MUST differ from JWT_ACCESS_SECRET. Generate: openssl rand -hex 32.
ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_ACCESS_TTL=15m
ADMIN_JWT_REFRESH_TTL_DAYS=7
# The staff console's exact browser origin (scheme + host, no trailing
# slash), e.g. https://admin.staging.usefiam.com. The API only accepts
# browser calls from here. (INTERNAL_API_KEY above is also required.)
ADMIN_CORS_ORIGIN=

