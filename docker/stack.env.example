# Copy to docker/stack.env on the server and fill in real values. Never
# commit the filled-in version — this is consumed via `docker stack deploy
# --env-file docker/stack.env`, which substitutes these into stack.yml's
# ${VAR} references client-side (this file itself is never uploaded to the
# swarm or baked into the image).

# --- Image to deploy (CI pushes here on every push to `staging`) ---
IMAGE=ghcr.io/francis-nova/fiam-retail-apis:staging

# --- Postgres (single instance, two databases — see postgres/init-databases.sh) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_USER=fiam
RABBITMQ_PASSWORD=

# --- MinIO (KYC document storage, used by auth) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=fiam-kyc-documents

# --- Shared JWT secrets — JWT_ACCESS_SECRET MUST be byte-identical between
# auth and payment (payment verifies auth-issued tokens without calling
# back to auth). Generate with: openssl rand -base64 48 ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d

# --- CORS (NODE_ENV=production disables CORS entirely in every app — this
# var only takes effect if that's changed later) ---
CORS_ORIGIN=*

# --- QoreID (BVN/NIN KYC — auth). Leave blank to keep KYC endpoints
# reachable but returning a clear error until real credentials exist. ---
QOREID_CLIENT_ID=
QOREID_SECRET=
QOREID_BASE_URL=https://api.qoreid.com

# --- VFD (wallet/payout provider — payment). Same "blank is safe" pattern
# as QoreID above. ---
VFD_AUTH_BASE_URL=https://api-devapps.vfdbank.systems/vfd-tech/baas-portal/v1.1/baasauth
VFD_WALLET_BASE_URL=https://api-devapps.vfdbank.systems/vtech-wallet/api/v2/wallet2
VFD_CONSUMER_KEY=
VFD_CONSUMER_SECRET=
VFD_WEBHOOK_SECRET=
VFD_BANK_CODE=999999
VFD_WALLET_NAME=FiamWallet

# --- Termii (SMS — postoffice) ---
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com

# --- ZeptoMail (email — postoffice) ---
EMAIL_FROM_ADDRESS=noreply@usefiam.com
EMAIL_FROM_NAME=Fiam
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_BASE_URL=api.zeptomail.com/
