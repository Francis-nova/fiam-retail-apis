# PRODUCTION. Copy to docker/.env on the production server only; never commit the
# filled-in file. Every secret must be freshly generated — never copy a value from
# staging. `bash production/preflight.sh` checks this file before you deploy.
# Generators: hex secrets `openssl rand -hex 32`; base64 `openssl rand -base64 48`;
# DB passwords `openssl rand -hex 24` (they go in URLs: no / @ : %).

# --- Let's Encrypt ---
ACME_EMAIL=

# --- Image (CI pushes :main on every push to main) ---
IMAGE=ghcr.io/francis-nova/fiam-retail-apis:main

# --- Hostnames (stack.yml defaults are the STAGING ones) ---
AUTH_HOST=api.auth.usefiam.com
PAYMENT_HOST=api.payment.usefiam.com
ADMIN_API_HOST=api.admin.usefiam.com
# The console is hosted on Netlify. Exact browser origin (scheme + host, no
# trailing slash); must match the Netlify custom domain.
ADMIN_CORS_ORIGIN=https://console.internal.usefiam.com

# --- Postgres: EXTERNAL (the in-stack one is scaled to 0 by production/stack.production.yml) ---
# Databases fiam_auth, fiam_payment, fiam_admin must already exist. The user needs
# CREATEROLE + CREATEDB (or superuser) once, for postgres/admin-roles.sql.
# Password: any characters, but if it has special ones wrap it in SINGLE quotes
# (POSTGRES_PASSWORD='p@ss$word'). deploy-stack.sh URL-encodes it for the URLs.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# TLS to the database. Save the server's certificate on this box (readable by
# the deploy user) and point DB_SSL_CA_HOST at it; DB_SSL_CA is where it appears
# inside the containers - leave as is.
DB_SSL=true
DB_SSL_CA_HOST=/opt/fiam/db-ca.pem
DB_SSL_CA=/etc/fiam/db-ca.pem

# --- RabbitMQ (in-stack, internal network only) ---
RABBITMQ_USER=fiam
RABBITMQ_PASSWORD=

# MinIO is still defined in stack.yml but unused in production (documents live in
# Hetzner Object Storage below). Set throwaway values so the service can start.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Object storage (shared Hetzner bucket, folder per environment) ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_PORT=443
OBJECT_STORAGE_USE_SSL=true
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_AUTO_CREATE_BUCKET=false
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=awuya-digital
OBJECT_STORAGE_PREFIX=fiam-production/

# --- Auth ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d
CORS_ORIGIN=*
KYC_PROVIDER=qoreid
INTERNAL_API_KEY=

# --- QoreID (LIVE credentials) ---
QOREID_CLIENT_ID=
QOREID_SECRET=
QOREID_BASE_URL=https://api.qoreid.com
QOREID_LIVENESS_CLIENT_ID=
QOREID_LIVENESS_SECRET=

# --- VFD (LIVE host + credentials; the stack.yml defaults are the dev sandbox).
# Take these from VFD's go-live pack. ---
VFD_AUTH_BASE_URL=
VFD_WALLET_BASE_URL=
VFD_CONSUMER_KEY=
VFD_CONSUMER_SECRET=
VFD_WEBHOOK_AUTH_TOKEN=
VFD_BANK_CODE=
VFD_WALLET_NAME=

# --- Termii / ZeptoMail / OneSignal (postoffice) ---
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
EMAIL_FROM_ADDRESS=noreply@usefiam.com
EMAIL_FROM_NAME=Fiam
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_BASE_URL=api.zeptomail.com/
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- Admin console API ---
ADMIN_DB_PASSWORD=
READONLY_DB_PASSWORD=
ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_ACCESS_TTL=15m
ADMIN_JWT_REFRESH_TTL_DAYS=7
ADMIN_TOTP_ENCRYPTION_KEY=
ADMIN_REQUIRE_2FA=true
# Office/VPN egress IPs or CIDRs, comma separated.
ADMIN_ALLOWED_IPS=
ADMIN_TOTP_ISSUER="Fiam Console"

# --- Backups (different passphrase from staging; keep a copy OFF this server) ---
RCLONE_CONFIG_HETZNER_TYPE=s3
RCLONE_CONFIG_HETZNER_PROVIDER=Other
RCLONE_CONFIG_HETZNER_ACCESS_KEY_ID=
RCLONE_CONFIG_HETZNER_SECRET_ACCESS_KEY=
RCLONE_CONFIG_HETZNER_ENDPOINT=
RCLONE_CONFIG_HETZNER_REGION=
RCLONE_CONFIG_HETZNER_NO_CHECK_BUCKET=true
BACKUP_RCLONE_REMOTE=hetzner:awuya-digital/fiam-production/backups
BACKUP_ENCRYPTION_PASSPHRASE=
